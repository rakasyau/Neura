# Template Environment Variables — Neura ML Platform
# Salin file ini menjadi `.env.local` dan isi dengan kredensial rahasia Anda.
# PENTING: `.env.local` sudah masuk dalam `.gitignore` agar tidak pernah ter-upload ke GitHub.

# MongoDB Atlas Connection String
# Dapatkan dari MongoDB Atlas Dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/neura?retryWrites=true&w=majority

# Google AI Studio Gemini API Key
# Dapatkan gratis dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (min 32 karakter acak untuk enkripsi sesi login)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Google OAuth Credentials (Opsional, untuk Google Sign-In)
# Dapatkan dari https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
